{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/cheng-bai/question-studio/schemas/question-package.schema.json",
  "title": "题序标准题包 v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schema_version", "package_id", "title", "questions", "files"],
  "properties": {
    "format": {"const": "question-studio-package"},
    "schema_version": {"const": "0.1"},
    "package_id": {"$ref": "#/definitions/id"},
    "title": {"type": "string", "minLength": 1, "maxLength": 300},
    "questions": {
      "type": "array", "minItems": 1, "maxItems": 200,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["question_id", "revision", "file", "sha256"],
        "properties": {
          "question_id": {"$ref": "#/definitions/id"},
          "revision": {"type": "integer", "minimum": 1},
          "file": {"type": "string", "pattern": "^questions/[A-Za-z0-9][A-Za-z0-9_-]{0,127}\\.md$"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "files": {"type": "object", "minProperties": 1, "maxProperties": 2200, "additionalProperties": {"type": "string"}},
    "handout": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "subtitle", "items"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 300},
        "subtitle": {"type": "string", "maxLength": 1000},
        "items": {
          "type": "array", "maxItems": 1000,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["question_id", "question_revision"],
            "properties": {
              "question_id": {"$ref": "#/definitions/id"},
              "question_revision": {"type": "integer", "minimum": 1},
              "role": {"type": "string", "maxLength": 300},
              "reason": {"type": "string", "maxLength": 2000}
            }
          }
        }
      }
    }
  },
  "definitions": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"}}
}
